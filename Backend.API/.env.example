# =====================
# Lumina Finance - Backend
# Copier ce fichier en .env et ajuster les valeurs
# =====================

# Base de données
CONNECTIONSTRINGS__DEFAULTCONNECTION=Server=(localdb)\MSSQLLocalDB;Database=BackendDb;Trusted_Connection=True;TrustServerCertificate=True

# JWT (GENERER UNE NOUVELLE CLE pour chaque environnement)
JWT__KEY=remplacer_par_une_cle_hexadecimal_64_caracteres
JWT__ISSUER=BackendAPI
JWT__AUDIENCE=BackendClient

# CORS
ALLOWEDORIGINS__0=http://localhost:4200

# SMTP (laisser vide pour sauvegarde locale des emails)
SMTP__HOST=
SMTP__PORT=587
SMTP__USERNAME=
SMTP__PASSWORD=
SMTP__FROMEMAIL=noreply@lumina-finance.com
SMTP__FROMNAME=Lumina Finance

# Admin par défaut (seed) - changer après première connexion
ADMIN__PASSWORD=Admin@123

# LLM compatible OpenAI (chat/completions) - assistant IA conversationnel + resume de dossier
# Groq propose un tier GRATUIT : creer une cle sur https://console.groq.com/keys (format gsk_...)
# Laisser vide pour utiliser le mode de repli (reponses deterministes)
# Autres fournisseurs possibles :
#   OpenAI :  LLM__BASEURL=https://api.openai.com/v1      LLM__MODEL=gpt-4o-mini
#   xAI Grok: LLM__BASEURL=https://api.x.ai/v1            LLM__MODEL=grok-3-mini
#   Gemini :  LLM__BASEURL=https://generativelanguage.googleapis.com/v1beta/openai/  LLM__MODEL=gemini-2.0-flash
LLM__APIKEY=
LLM__BASEURL=https://api.groq.com/openai/v1
LLM__MODEL=llama-3.3-70b-versatile
LLM__TIMEOUTSECONDS=60

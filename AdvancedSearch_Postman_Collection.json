        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"philippe\",\n  \"mode\": \"Phonetic\",\n  \"categories\": [\"Clients\"]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/advancedsearch/search",
          "host": ["{{baseUrl}}"],
          "path": ["api", "advancedsearch", "search"]

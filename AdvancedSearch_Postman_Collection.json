    {
      "name": "6. Obtenir Suggestions",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/advancedsearch/suggestions?query=mar",
          "host": ["{{baseUrl}}"],
          "path": ["api", "advancedsearch", "suggestions"],
          "query": [
            {
              "key": "query",
              "value": "mar"
            }
          ]
        }
      }
    },

{
  "info": {
    "name": "Lumina Finance - Advanced Search API",
    "description": "Collection de tests pour la recherche intelligente avancée",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Recherche Simple",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"martin\",\n  \"mode\": \"Fuzzy\",\n  \"categories\": [\"All\"],\n  \"page\": 1,\n  \"pageSize\": 10\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/advancedsearch/search",
          "host": ["{{baseUrl}}"],
          "path": ["api", "advancedsearch", "search"]
        }
      }
    },
    {
      "name": "2. Recherche Clients avec Filtres",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"paris\",\n  \"mode\": \"Fuzzy\",\n  \"categories\": [\"Clients\"],\n  \"clientFilters\": {\n    \"villes\": [\"Paris\", \"Lyon\"],\n    \"statuts\": [\"Actif\"],\n    \"revenuMin\": 2000,\n    \"revenuMax\": 5000,\n    \"ageMin\": 25,\n    \"ageMax\": 45\n  },\n  \"page\": 1,\n  \"pageSize\": 20,\n  \"sortBy\": \"Relevance\",\n  \"sortDirection\": \"Desc\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/advancedsearch/search",
          "host": ["{{baseUrl}}"],
          "path": ["api", "advancedsearch", "search"]
        }
      }
    },
    {
      "name": "3. Recherche Documents",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"contrat\",\n  \"mode\": \"Fuzzy\",\n  \"categories\": [\"Documents\"],\n  \"documentFilters\": {\n    \"typesDocument\": [\"Contrat\", \"Facture\"],\n    \"statutsValidation\": [\"Validé\"],\n    \"extensions\": [\".pdf\"]\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/advancedsearch/search",
          "host": ["{{baseUrl}}"],
          "path": ["api", "advancedsearch", "search"]
        }
      }
    },
    {
      "name": "4. Recherche par Tags",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"categories\": [\"Clients\"],\n  \"tags\": [\"VIP\", \"Premium\"],\n  \"page\": 1,\n  \"pageSize\": 10\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/advancedsearch/search",
          "host": ["{{baseUrl}}"],
          "path": ["api", "advancedsearch", "search"]
        }
      }
    },
    {
      "name": "5. Recherche Phonétique",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
